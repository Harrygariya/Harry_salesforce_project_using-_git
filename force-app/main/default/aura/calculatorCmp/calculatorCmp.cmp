<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" access="global" >
 <div class="row">
        <lightning:input aura:id ="num1" type="number" name="input1" label="Enter a number" />
        <lightning:input aura:id ="num2" type="number" name="input2" label="Enter a number" value=""/>
        <lightning:input type="submit"  onclick="{!c.Calculate}" name="input3" label="add"/>
     <p></p>
    </div>
</aura:component>