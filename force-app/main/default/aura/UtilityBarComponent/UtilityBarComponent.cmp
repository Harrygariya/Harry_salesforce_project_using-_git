<aura:component implements="force:appHostable,lightning:utilityItem,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction" access="global" >
    <aura:handler name="doinit" value="{! this }" action="{! c.doinit }"/>
    <lightning:utilityBarAPI aura:id="utilitybar" />

    <!-- VF Page inside iframe -->
    <iframe src="/apex/test" width="100%" height="300px"></iframe>
</aura:component>