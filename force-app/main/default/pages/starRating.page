                        </div>
                        <button type="button" class="btn btn-blue" onclick = "mayBeLater();">May be Later</button>
                    </div>
                    -->
                </div>
            </div>
        </div>    
    </apex:form>
        <script>
            $(document).ready(function(){
            $('#stars li').on('mouseover', function(){
                var onStar = parseInt($(this).data('value'), 10); 
                $(this).parent().children('li.star').each(function(e){
                    if (e < onStar) {
                        $(this).addClass('hover');
                    }
                    else {
                        $(this).removeClass('hover');
                    }
                });
                
            }).on('mouseout', function(){
                $(this).parent().children('li.star').each(function(e){
                    $(this).removeClass('hover');
                });
            });
              
            $('#stars li').on('click', function(){
                var onStar = parseInt($(this).data('value'), 10); 
                var stars = $(this).parent().children('li.star');
                for (i = 0; i < stars.length; i++) {
                  $(stars[i]).removeClass('selected');
                }
                for (i = 0; i < onStar; i++) {
                  $(stars[i]).addClass('selected');
                }
            });
        });

        function feedBackfn(feedStars){
            $('#fdrvNo').val(feedStars);
            if(feedStars >4){
                $("#posReview").css("display", "block");
                $("#negReview").css("display", "none");
            }
            else{
                $("#negReview").css("display", "block");
                $("#posReview").css("display", "none");
            }
            if(feedStars == 1){
                $('.moodWrapper .Moderately_sad, .moodWrapper .Neutral, .moodWrapper .Moderately_Happy, .moodWrapper .Happy').hide();
                $('.moodWrapper .sad').show()
            }else if(feedStars == 2){
                $('.moodWrapper .sad, .moodWrapper .Neutral, .moodWrapper .Moderately_Happy, .moodWrapper .Happy').hide();
                $('.moodWrapper .Moderately_sad').show()
            }else if(feedStars == 3){
                $('.moodWrapper .sad, .moodWrapper .Moderately_sad, .moodWrapper .Moderately_Happy, .moodWrapper .Happy').hide();
                $('.moodWrapper .Neutral').show()
            }else if(feedStars == 4){
                $('.moodWrapper .sad, .moodWrapper .Moderately_sad, .moodWrapper .Neutral, .moodWrapper .Happy').hide();
                $('.moodWrapper .Moderately_Happy').show()
            }else if(feedStars == 5){
                $('.moodWrapper .sad, .moodWrapper .Moderately_sad, .moodWrapper .Neutral, .moodWrapper .Moderately_Happy').hide();
                $('.moodWrapper .Happy').show()
            }else if(feedStars == 11){
                $('.moodWrapper .sad, .moodWrapper .Moderately_sad, .moodWrapper .Neutral, .moodWrapper .Moderately_Happy').hide();
                $('.moodWrapper .Happy').show()
            }
            else if(feedStars == 21){
                $('.moodWrapper .sad, .moodWrapper .Moderately_sad, .moodWrapper .Neutral, .moodWrapper .Moderately_Happy').hide();
                $('.moodWrapper .Happy').show()
            }
            else if(feedStars == 31){
                $('.moodWrapper .sad, .moodWrapper .Moderately_sad, .moodWrapper .Neutral, .moodWrapper .Moderately_Happy').hide();
                $('.moodWrapper .Happy').show()
            }
            else if(feedStars == 41){
                $('.moodWrapper .sad, .moodWrapper .Moderately_sad, .moodWrapper .Neutral, .moodWrapper .Moderately_Happy').hide();
                $('.moodWrapper .Happy').show()
            }
            else if(feedStars == 51){
                $('.moodWrapper .sad, .moodWrapper .Moderately_sad, .moodWrapper .Neutral, .moodWrapper .Moderately_Happy').hide();
                $('.moodWrapper .Happy').show()
            }
        }
       
    </script>
</apex:page>