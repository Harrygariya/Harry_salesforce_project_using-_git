            -moz-user-select:none;
            -webkit-user-select:none;
            position : relative;
            font-size: 14px;
            font-weight: bolder;
        }
        #page_wrapperId .rating-stars ul > li{
            margin-left: 0;
        }
        #page_wrapperId .rating-stars ul > li.star {
            display:inline-block;
          
        }
        #page_wrapperId .rating-stars ul > li.star > i.fa {
            font-size:2.5rem; 
            color:#ccc;
        }
        #page_wrapperId .rating-stars ul > li.star.hover > i.fa {
            color:#FFCC36;
        }
        #page_wrapperId .rating-stars ul > li.star.selected > i.fa {
            color:#FF912C;
        }
        #page_wrapperId .moodWrapper .sad, #page_wrapperId .moodWrapper .Moderately_sad, #page_wrapperId .moodWrapper .Neutral, #page_wrapperId .moodWrapper .Moderately_Happy, #page_wrapperId .moodWrapper .Happy{
            max-width: 80px;
            margin-bottom: 1rem;
        }
        #page_wrapperId .moodWrapper .sad, #page_wrapperId .moodWrapper .Moderately_sad, #page_wrapperId .moodWrapper .Neutral, #page_wrapperId .moodWrapper .Moderately_Happy, #page_wrapperId .moodWrapper .Happy{
            display: none;
        }
        #page_wrapperId .main_div{
            font-size: 14px;
            font-weight: bolder;
            width: 34%;
            margin: auto;
            display: flex;                        
        }
        #page_wrapperId textarea.form-control {
            height: 100px !important;
        }
    </style>
   <apex:form >
       <div id="page_wrapperId">
            <div id="feedbackStarDiv" style = "display:block">
                <div style="width: 100%">
                    <div class="moodWrapper">
                    <apex:image url="data:image/png;base64," styleClass="sad"/>
                        
                    </div> 
                    <input type = "text" id ="fdrvNo" value = '0' style = "display:none"/>
                    <div class='rating-widget'>
                        <div class='rating-stars text-center'>
                            <ul id='stars'>
                                <li class='star' title='Poor' data-value='1' id="star1">
                                    <i onclick = "feedBackfn(1)" class='fa fa-star fa-fw'></i>
                                </li>
                                <li class='star' title='Fair' data-value='2' id="star2">
                                    <i onclick = "feedBackfn(2)" class='fa fa-star fa-fw'></i>
                                </li>
                                <li class='star' title='Good' data-value='3'>
                                    <i onclick = "feedBackfn(3)" class='fa fa-star fa-fw'></i>
                                </li>
                                <li class='star' title='Excellent' data-value='4'>
                                    <i onclick = "feedBackfn(4)" class='fa fa-star fa-fw'></i>
                                </li>
                                <li class='star' title='WOW!!!' data-value='5' id="star5">
                                    <i onclick = "feedBackfn(5)" class='fa fa-star fa-fw'></i>
                                </li>
                            </ul>
                        </div>
                    </div>
                   
                    <div class='rating-widget'>
                        <div class='rating-stars text-center'>
                            <ul id='stars'>
                                <li class='star' title='Poor' data-value='11' id="star11">
                                    <i onclick = "feedBackfn(11)" class='fa fa-star fa-fw'></i>
                                </li>
                                <li class='star' title='Fair' data-value='21' id="star21">
                                    <i onclick = "feedBackfn(21)" class='fa fa-star fa-fw'></i>
                                </li>
                                <li class='star' title='Good' data-value='31'>
                                    <i onclick = "feedBackfn(31)" class='fa fa-star fa-fw'></i>
                                </li>
                                <li class='star' title='Excellent' data-value='41'>
                                    <i onclick = "feedBackfn(41)" class='fa fa-star fa-fw'></i>
                                </li>
                                <li class='star' title='WOW!!!' data-value='51' id="star5">
                                    <i onclick = "feedBackfn(51)" class='fa fa-star fa-fw'></i>
                                </li>
                            </ul>
                        </div>
                    </div>
                 <!--  
                    <div id = "negReview" style="display:none;">
                        <div class="question_cls form-group">Thank you so much for taking the time to provide your feedback. Your account rep will be in touch shortly to discuss the areas we can improve upon.</div>
                        <div class="form-group">
                            <apex:inputTextarea styleClass="review form-control" html-maxlength="1000" rows="2" cols="10"></apex:inputTextarea>
                        </div>
                        <button type="button" class="btn btn-blue" onclick = "return submitReview();" >Submit</button>
                    </div>
                    <div id= "posReview" style="display:none;">
                        <div class="ratting_topup">
